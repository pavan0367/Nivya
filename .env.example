# ==============================================================================
# Nivya - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and replace placeholder values with actual secrets.
# NEVER commit the .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME=Nivya
APP_ENV=development
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CLIENT_MIN_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. DATABASE (MySQL)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nivya_db
MYSQL_USER=nivya_user
MYSQL_PASSWORD=nivya_secure_dev_password_2026
MYSQL_ROOT_PASSWORD=nivya_root_super_secret_dev_pass_2026
DATABASE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONNECTION_TIMEOUT=20000

# ------------------------------------------------------------------------------
# 3. REDIS (Caching & Real-Time Message Bus)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nivya_redis_secure_dev_password
REDIS_DATABASE=0
REDIS_TIMEOUT=2000

# ------------------------------------------------------------------------------
# 4. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Minimum 256-bit secret key for HMAC-SHA256 signing
JWT_SECRET=4e6976796153656375726546616d696c795361666574794b6579323032363132
# Access Token Lifetime in milliseconds (e.g., 15 minutes = 900000)
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
# Refresh Token Lifetime in milliseconds (e.g., 7 days = 604800000)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_PAIRING_PER_MINUTE=5

# ------------------------------------------------------------------------------
# 5. PAIRING & CONNECTION CODE ENGINE
# ------------------------------------------------------------------------------
# Pairing code validity in minutes (e.g. 10 minutes)
PAIRING_CODE_TTL_MINUTES=10
# Maximum failed attempts before lockout
PAIRING_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 6. CONVOCATION SPECIFICATIONS
# ------------------------------------------------------------------------------
# Child-side 2-minute viewing mode duration in seconds (Authoritative Server Value)
CONVOCATION_VIEW_MODE_DURATION_SECONDS=120
# Viewed parent message expiration from child visibility in hours
CONVOCATION_CHILD_VIEWED_EXPIRY_HOURS=1
# Generic notification string sent to child upon new Parent Convocation message
CONVOCATION_CHILD_NOTIFICATION_TEXT=Check your battery status

# ------------------------------------------------------------------------------
# 7. TELEMETRY & RETENTION SETTINGS
# ------------------------------------------------------------------------------
# Raw operational telemetry retention in days
TELEMETRY_RAW_RETENTION_DAYS=7
# Aggregated daily/weekly summary retention in days
TELEMETRY_SUMMARY_RETENTION_DAYS=90
# Location history retention in days
LOCATION_HISTORY_RETENTION_DAYS=30
# Heartbeat interval threshold for offline alert in seconds
DEVICE_OFFLINE_THRESHOLD_SECONDS=300

# ------------------------------------------------------------------------------
# 8. CORS & WEB CLIENT
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/ws

# ------------------------------------------------------------------------------
# 9. PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
# Path to service account JSON (leave blank if mock or not configured in dev)
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=nivya-family-safety

# ------------------------------------------------------------------------------
# 10. MONITORING & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_NIVYA=DEBUG
SENTRY_DSN=

# ==============================================================================
# Nivya Platform - Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. In PRODUCTION:
#    - Replace ALL placeholder passwords and secrets with strong, unique values.
#    - Generate random 256-bit secrets via: openssl rand -hex 32
# 3. NEVER commit the live '.env' file to version control. It is git-ignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL 8.0 Database Configuration
# ------------------------------------------------------------------------------
# Root password for administrative maintenance and backup operations
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password_in_production

# Target application database name
MYSQL_DATABASE=nivya_db

# Dedicated unprivileged database user for the backend service
MYSQL_USER=nivya_user

# Password for the dedicated application database user
MYSQL_PASSWORD=replace_with_strong_application_db_password_in_production

# Host port for development only (when using docker-compose.dev.yml)
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 2. Redis 7.2 Configuration
# ------------------------------------------------------------------------------
# Authentication password for Redis (AOF persistence enabled)
REDIS_PASSWORD=replace_with_strong_redis_password_in_production

# Host port for development only (when using docker-compose.dev.yml)
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
# Spring active profile: 'prod' for production, 'dev' for local development
SPRING_PROFILES_ACTIVE=prod

# Backend internal port (container internal)
SERVER_PORT=8080

# HS256 / HMAC-SHA256 Secret Key (minimum 256 bits / 64 hex characters)
# Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_64_hex_character_random_jwt_secret_key_prod

# JWT access token time-to-live in milliseconds (default: 900000 = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# JWT refresh token time-to-live in milliseconds (default: 604800000 = 7 days)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Permitted CORS origins (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=https://nivya.yourdomain.com,https://app.nivya.yourdomain.com

# Pairing code validity duration in minutes (default: 10 minutes)
PAIRING_CODE_TTL_MINUTES=10

# Convocation live viewing duration in seconds (default: 120 seconds = 2 minutes)
CONVOCATION_VIEW_MODE_DURATION_SECONDS=120

# Convocation child viewed record expiry in hours (default: 1 hour)
CONVOCATION_CHILD_VIEWED_EXPIRY_HOURS=1

# Convocation push notification alert message sent to child
CONVOCATION_CHILD_NOTIFICATION_TEXT=Check your battery status

# Firebase Cloud Messaging (FCM) Integration
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# HikariCP Database Connection Pool Optimization (Production)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONNECTION_TIMEOUT=20000

# ------------------------------------------------------------------------------
# 4. React Frontend SPA Configuration
# ------------------------------------------------------------------------------
# Base URL for REST API (empty string defaults to same-origin reverse proxy /api)
VITE_API_BASE_URL=

# Base URL for WebSocket STOMP endpoint (empty string defaults to same-origin /ws)
VITE_WS_BASE_URL=

# ------------------------------------------------------------------------------
# 5. Nginx Gateway & Domain Configuration
# ------------------------------------------------------------------------------
# Public HTTP port
HTTP_PORT=80

# Public HTTPS port
HTTPS_PORT=443

# Production Fully Qualified Domain Name
DOMAIN_NAME=nivya.yourdomain.com

# ==============================================================================
# Nivya Web - Environment Configuration Template (.env.example)
# ==============================================================================
# In Development:
# Leave blank or default to local relative endpoints proxied by Vite/Nginx:
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/ws

# Optional email verification requirement gate for frontend:
VITE_EMAIL_VERIFICATION_REQUIRED=false

# Optional Google Maps JavaScript API key for interactive map visualization:
# If unset, a fallback view displays device coordinates without crashing.
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# In Production (Cloudflare Pages):
# Configure the following environment variables in the Cloudflare Pages dashboard:
# Settings -> Environment Variables (Production & Preview):
#
#   VITE_API_BASE_URL = https://nivya-blbf.onrender.com/api/v1
#   VITE_WS_BASE_URL  = https://nivya-blbf.onrender.com/ws
#   VITE_EMAIL_VERIFICATION_REQUIRED = true
#   VITE_GOOGLE_MAPS_API_KEY = <your-google-maps-api-key>
# ------------------------------------------------------------------------------

VITE_GOOGLE_MAPS_API_KEY=
